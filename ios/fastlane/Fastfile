default_platform(:ios)

platform :ios do
  desc "Build Development IPA (no upload)"
  lane :dev_build do
    # Flutter build
    Dir.chdir("..") do
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end

    sh("pod", "install")

    team_id = "K8L45AHLHB" # Từ xcrun altool --list-providers

    # Update app identifier
    update_app_identifier(
      xcodeproj: "Runner.xcodeproj",
      plist_path: "Runner/Info.plist",
      app_identifier: "com.example.flutter3270.dev"
    )

#     # Enable automatic signing
#     update_code_signing_settings(
#       use_automatic_signing: true,
#       team_id: team_id,
#       bundle_identifier: "com.example.flutter3270.dev",
#       path: "Runner.xcodeproj"
#     )

    # Increment build number
    increment_build_number(
      xcodeproj: "Runner.xcodeproj"
    )

    enable_automatic_code_signing(path: "Runner.xcodeproj")

    # Build development version (không cần App Store Connect)
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "dev",
      configuration: "Release",
      export_method: "app-store", # Development export
      output_directory: "./build",
      output_name: "flutter_3270_dev.ipa",
      clean: true,
      include_bitcode: false,
      export_options: {
        method: "app-store",
        teamID: team_id,
        signingStyle: "automatic",
        uploadBitcode: false,
        uploadSymbols: true,
        compileBitcode: false
      }
    )

    UI.success("✅ Development build completed: ./build/flutter_3270_dev.ipa")
  end

  desc "Setup certificates and provisioning profiles"
  lane :certificates do |options|
    match(
      type: "appstore",
      app_identifier: "com.example.flutter3270.dev",
      git_url: "git@github.com-global:ducphan1311/fastlane_certificate.git",
      verbose: true,
      force_for_new_devices: true,
      shallow_clone: true,
      api_key: options[:api_key]
    )
  end

  desc "Build and upload to TestFlight"
  lane :dev do
    # Create the App Store Connect API key object.
    # This requires you to set three environment variables:
    # 1. APP_STORE_CONNECT_KEY_ID: Your API Key ID from App Store Connect.
    # 2. APP_STORE_CONNECT_ISSUER_ID: Your Issuer ID from App Store Connect.
    # 3. APP_STORE_CONNECT_API_KEY_PATH: The absolute path to your .p8 API key file.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )

    # Setup certificates first, passing the API key
    certificates(api_key: api_key)
    
    # Build development version
    dev_build

    # Upload to TestFlight using the generated API key.
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/flutter_3270_dev.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
